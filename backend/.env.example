APP_NAME=Features Base API
API_PREFIX=/api
DEBUG=false
FRONTEND_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
OPENCODE_PASSWORD=change-me
OPENCODE_ADMIN_TOKEN=change-me
OPENCODE_CONTAINER_CPU=1.0
OPENCODE_CONTAINER_MEMORY=2g
OPENCODE_MAX_CONTAINERS=4
OPENCODE_STARTUP_TIMEOUT=180
OPENCODE_IMAGE=dynamic-opencode:latest
OPENCODE_TUNNEL_PROBE_INTERVAL=30
OPENCODE_TUNNEL_FAILURE_THRESHOLD=3
OPENCODE_TUNNEL_RECOVERY_ATTEMPTS=3
OPENCODE_TUNNEL_RECOVERY_DELAY=2
OPENCODE_TUNNEL_RETRY_INITIAL_DELAY=5
OPENCODE_TUNNEL_RETRY_MAX_DELAY=60
OPENCODE_CLI_RELEASE_URL=https://github.com/jason23452/more-opnecode-server/releases/latest/download
